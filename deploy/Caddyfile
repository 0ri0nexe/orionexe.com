# orionexe.com — static site served straight off disk.
#
# Installed to /etc/caddy/sites/orionexe.com.caddy by scripts/provision.sh.
# `current` is a symlink flipped atomically by scripts/deploy.sh.

orionexe.com {
	root * /srv/orionexe/current

	# Timetable: personal data, behind a password.
	# The bcrypt hash comes from /etc/caddy/edt.env (see scripts/provision-edt.sh),
	# it is not versioned.
	@edt path /edt /edt/ /edt/*
	basicauth @edt {
		{$EDT_WEB_USER} {$EDT_WEB_HASH}
	}

	# "Refresh" button: a local service (edt-refresh.service) re-runs the scrape.
	# It has no auth of its own — it listens on 127.0.0.1 only, and the @edt
	# matcher above already covers /edt/refresh.
	@edt_refresh path /edt/refresh
	reverse_proxy @edt_refresh 127.0.0.1:8899

	# The JSON is rewritten hourly by the cron: it lives outside the releases,
	# otherwise a deploy would replace it with a stale copy.
	@edt_data path /edt/schedule.json
	root @edt_data /srv/orionexe/shared
	header @edt_data Cache-Control "no-store"

	encode zstd gzip
	file_server {
		precompressed zstd gzip
	}

	# Fingerprinted build assets never change under the same name.
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# HTML is revalidated on every request so a deploy is visible immediately.
	@html path *.html /
	header @html Cache-Control "public, max-age=0, must-revalidate"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server
	}

	log {
		output file /var/log/caddy/orionexe.com.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

www.orionexe.com {
	redir https://orionexe.com{uri} permanent
}
