# orionexe.com — static site served straight off disk.
#
# Installed to /etc/caddy/sites/orionexe.com.caddy by scripts/provision.sh.
# `current` is a symlink flipped atomically by scripts/deploy.sh.

orionexe.com {
	root * /srv/orionexe/current
	encode zstd gzip
	file_server {
		precompressed zstd gzip
	}

	# Fingerprinted build assets never change under the same name.
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# HTML is revalidated on every request so a deploy is visible immediately.
	@html path *.html /
	header @html Cache-Control "public, max-age=0, must-revalidate"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server
	}

	log {
		output file /var/log/caddy/orionexe.com.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

www.orionexe.com {
	redir https://orionexe.com{uri} permanent
}
