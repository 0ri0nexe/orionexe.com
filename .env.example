# Copy to .env (never committed), then ./scripts/provision-edt.sh
#
# Keep the single quotes: this file is sourced by bash, and a password
# containing > ! } $ would otherwise be truncated or interpreted.

# VPS the deploy scripts talk to — kept out of the repo on purpose
REMOTE_USER=''
REMOTE_HOST=''

# IMT portal — used by the scraper on the VPS
EDT_USER=''
EDT_PASS=''

# Access to https://orionexe.com/edt/ (basic Caddy auth)
EDT_WEB_USER=''
EDT_WEB_PASS=''
